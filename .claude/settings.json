{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precommit-tests.sh",
            "if": "Bash(git commit*)",
            "timeout": 600,
            "statusMessage": "Green-bar gate: running ZeusTests before commit…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
